!/Restore-CS2-Settings.cmd
!/Start-CS2-Performance.cmd
!/工作台.cmd
!/src/
!/tests/
!/configs/
!/scripts/
!/ui/
!/docs/

# Public documentation only; retain local research and session evidence locally.
/docs/*
!/docs/release/
!/docs/development-guide.md
!/docs/license-history.md
!/docs/训练与调试.txt

# One-off legacy script containing a local account path; not a product entry.
/scripts/bind-flight.py

