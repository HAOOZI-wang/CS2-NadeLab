# Public source boundary. New root entries must be deliberately admitted.
/*
!/.gitignore
!/.gitattributes
!/.github/
!/LICENSE
!/README.md
!/CONTRIBUTING.md
!/SECURITY.md
!/THIRD_PARTY_NOTICES.md
!/CHANGELOG.md
!/Directory.Build.props
!/NadeLab.slnx
